# Ooh La Langue — configuration template.
# Copy to .env and fill in the values you have. Keys are read only on the
# server and are NEVER sent to the browser or reported by /health.

# ---- Text provider ---------------------------------------------------------
# "ollama" (default, Ollama Cloud) or "openai".
TEXT_PROVIDER=ollama

# Ollama Cloud. OLLAMA_MODEL is env-driven with no hardcoded default: set the
# exact model name available to your account (verify it against your Ollama
# Cloud account before release).
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# OpenAI text (also required for listening audio /api/tts, below).
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Text-to-speech (listening section) ------------------------------------
# Verify model/voice names against your OpenAI account before release.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---- Server ----------------------------------------------------------------
PORT=3000

# Optional: if set, visitors must enter this password before they can chat.
# Leave blank (or omit the line) to disable the password gate.
APP_PASSWORD=

# ---- Chat session limit (existing behavior) --------------------------------
CHAT_ANSWERS_PER_WINDOW=10
CHAT_PAUSE_HOURS=3
