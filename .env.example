# Ooh La Langue — configuration template.
# Copy to .env and fill in the values you have. Keys are read only on the
# server and are NEVER sent to the browser or reported by /health.

# ---- Text provider ---------------------------------------------------------
# "ollama" (default, Ollama Cloud) or "openai".
TEXT_PROVIDER=ollama

# Ollama Cloud. OLLAMA_MODEL is env-driven with no hardcoded default: set the
# exact model name available to your account (verify it against your Ollama
# Cloud account before release).
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Set true only to surface model reasoning; leave false for strict JSON answers.
# OLLAMA_THINK=false

# OpenAI text (also required for listening audio /api/tts, below).
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Text-to-speech (listening section) ------------------------------------
# Verify model/voice names against your OpenAI account before release.
# Voices default to OpenAI-legal names; the worksheet asks for "male"/"female",
# which map to OPENAI_TTS_VOICE_MALE / OPENAI_TTS_VOICE_FEMALE.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_VOICE_MALE=onyx
OPENAI_TTS_VOICE_FEMALE=nova

# ---- Server ----------------------------------------------------------------
PORT=3000

# Optional: if set, visitors must enter this password before using Chat or the
# Worksheet. Leave blank (or omit the line) to disable the gate.
APP_PASSWORD=

# ---- Advanced (optional) ---------------------------------------------------
# Request timeouts (ms) and per-request token caps. The values below are the
# built-in defaults; uncomment only to override.
# AI_TIMEOUT_MS=30000
# TTS_TIMEOUT_MS=45000
# WORKSHEET_MAX_TOKENS=3000
# FEEDBACK_MAX_TOKENS=3000

# Note: the chat session limit (10 answers, then a 3-hour pause) is a hardcoded
# client behavior preserved from the original app. It is intentionally NOT
# configurable here.
